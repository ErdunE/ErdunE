---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { buttonVariants } from "@/components/ui/button";

const sections = [
  "experience",
  "projects",
  "capability",
  "testimonials",
  "education",
  "contact",
];
---

<Base>
  <span id="top"></span>
  <Nav />

  <main id="main" class="pt-24">
    {/* Layout-shell placeholder — real Hero arrives in Phase 3. */}
    <section class="container-page py-20">
      <p class="eyebrow mb-4">Software Engineer · ex-AWS EBS</p>
      <h1 class="h-display max-w-3xl text-text">Erdun E</h1>
      <p class="mt-5 max-w-xl text-lg text-muted">
        builder · engineer · always shipping
      </p>
      <p class="mt-2 max-w-xl text-muted">
        Lifelong big-mountain skier. Former Software Engineer at Amazon.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#projects" class={buttonVariants({ size: "lg" })}>View work</a>
        <a href="#experience" class={buttonVariants({ variant: "outline", size: "lg" })}>
          Experience
        </a>
      </div>

      {/* Token / theme verification strip */}
      <div class="mt-16 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-[var(--radius-card)] border border-border bg-surface p-4">
          <div class="eyebrow">surface</div>
          <div class="mt-2 h-8 rounded-[var(--radius-sm)] bg-surface-2"></div>
        </div>
        <div class="rounded-[var(--radius-card)] border border-border bg-surface p-4">
          <div class="eyebrow">accent</div>
          <div class="mt-2 h-8 rounded-[var(--radius-sm)] bg-accent"></div>
        </div>
        <div class="rounded-[var(--radius-card)] border border-border bg-surface p-4">
          <div class="eyebrow">accent soft</div>
          <div class="mt-2 h-8 rounded-[var(--radius-sm)] bg-accent-soft"></div>
        </div>
        <div class="rounded-[var(--radius-card)] border border-border-strong bg-surface p-4">
          <div class="eyebrow">text / muted</div>
          <p class="mt-2 text-sm text-text">Aa <span class="text-muted">Aa</span></p>
        </div>
      </div>
    </section>

    {/* Anchor stubs so nav links resolve until Phase 3 fills sections. */}
    {
      sections.map((id) => (
        <section id={id} class="container-page border-t border-border py-16">
          <p class="eyebrow">{id}</p>
          <p class="mt-3 text-muted">Section coming in Phase 3.</p>
        </section>
      ))
    }
  </main>

  <Footer />
</Base>
