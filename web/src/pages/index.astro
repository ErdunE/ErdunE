---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";

// Sections still to be built in the rest of Phase 3.
const sections = [
  "experience",
  "projects",
  "capability",
  "testimonials",
  "education",
  "contact",
];
---

<Base>
  <span id="top"></span>
  <Nav />

  <main id="main">
    <Hero />

    {/* Anchor stubs so nav links resolve until each section is built. */}
    {
      sections.map((id) => (
        <section id={id} class="container-page border-t border-border py-16">
          <p class="eyebrow">{id}</p>
          <p class="mt-3 text-muted">Section coming soon.</p>
        </section>
      ))
    }
  </main>

  <Footer />
</Base>
