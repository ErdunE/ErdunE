---
import ThemeToggle from "./ThemeToggle.tsx";
import MobileNav from "./MobileNav.tsx";
import { NAV_LINKS, RESUME_HREF } from "@/lib/nav";
import { buttonVariants } from "@/components/ui/button";
---

<header
  id="site-nav"
  class="nav-over-hero fixed inset-x-0 top-0 z-40 border-b border-transparent transition-[background-color,backdrop-filter,border-color,padding] duration-300"
>
  <div class="container-page flex items-center justify-between py-4">
    <a
      href="#top"
      class="nav-brand focus-ring flex items-center gap-2 rounded-sm font-display text-lg font-bold text-text"
    >
      Erdun E<span class="inline-block size-2 rounded-full bg-accent"></span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="nav-link focus-ring relative rounded-sm font-mono text-[11px] uppercase tracking-[0.14em] text-muted transition-colors hover:text-text"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5">
      <a
        href={RESUME_HREF}
        target="_blank"
        rel="noopener"
        class={buttonVariants({ variant: "outline", size: "sm", className: "nav-resume hidden sm:inline-flex" })}
      >
        Résumé
      </a>
      <span class="nav-toggle">
        <ThemeToggle client:load />
      </span>
      <span class="nav-mobile md:hidden">
        <MobileNav client:load />
      </span>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var nav = document.getElementById("site-nav");
    if (!nav) return;
    var onScroll = function () {
      if (window.scrollY > 16) {
        nav.classList.add("nav-scrolled");
        nav.classList.remove("nav-over-hero");
      } else {
        nav.classList.add("nav-over-hero");
        nav.classList.remove("nav-scrolled");
      }
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>

<style>
  /* Scrolled into content: theme-colored nav + backdrop blur (both themes). */
  #site-nav.nav-scrolled {
    background-color: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: var(--blur-nav);
    -webkit-backdrop-filter: var(--blur-nav);
    border-bottom-color: var(--border);
  }
  #site-nav.nav-scrolled .container-page {
    padding-top: 0.625rem;
    padding-bottom: 0.625rem;
  }

  /* Over the hero: transparent bg + top-down scrim + forced white text,
     legible over any video frame in both themes. */
  #site-nav.nav-over-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    bottom: auto;
    height: 8rem;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
    z-index: -1;
  }
  #site-nav.nav-over-hero .nav-brand,
  #site-nav.nav-over-hero .nav-link,
  #site-nav.nav-over-hero .nav-resume,
  #site-nav.nav-over-hero .nav-toggle :global(button),
  #site-nav.nav-over-hero .nav-mobile :global(button) {
    color: #fff;
  }
  #site-nav.nav-over-hero .nav-resume {
    border-color: rgba(255, 255, 255, 0.4);
  }
  @media (hover: hover) and (pointer: fine) {
    #site-nav.nav-over-hero .nav-resume:hover,
    #site-nav.nav-over-hero .nav-toggle :global(button):hover,
    #site-nav.nav-over-hero .nav-mobile :global(button):hover {
      background-color: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, var(--on-media-soft));
    }
  }
</style>
