---
import ThemeToggle from "./ThemeToggle.tsx";
import MobileNav from "./MobileNav.tsx";
import { NAV_LINKS, RESUME_HREF } from "@/lib/nav";
import { buttonVariants } from "@/components/ui/button";
---

<header
  id="site-nav"
  class="nav-over-hero fixed inset-x-0 top-0 z-40 border-b border-transparent transition-[background-color,backdrop-filter,border-color,padding] duration-300"
>
  <div class="container-page flex items-center justify-between py-4">
    <a
      href="#top"
      class="nav-brand focus-ring flex items-center gap-2 rounded-sm font-display text-lg font-bold text-text"
    >
      Erdun E<span class="inline-block size-2 rounded-full bg-accent"></span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="nav-link focus-ring relative rounded-sm font-mono text-[11px] uppercase tracking-[0.14em] text-muted transition-colors hover:text-text"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5">
      <a
        href={RESUME_HREF}
        target="_blank"
        rel="noopener"
        class={buttonVariants({ variant: "outline", size: "sm", className: "nav-resume hidden sm:inline-flex" })}
      >
        Résumé
      </a>
      <span class="nav-toggle">
        <ThemeToggle client:load />
      </span>
      <span class="nav-mobile md:hidden">
        <MobileNav client:load />
      </span>
    </div>
    {/* Scroll progress fill pinned to the nav's lower edge. */}
    <div class="nav-progress" aria-hidden="true"></div>
  </div>
</header>

<script is:inline>
  (function () {
    var nav = document.getElementById("site-nav");
    if (!nav) return;
    var bar = nav.querySelector(".nav-progress");

    var ticking = false;
    var update = function () {
      ticking = false;
      var y = window.scrollY;
      if (y > 16) {
        nav.classList.add("nav-scrolled");
        nav.classList.remove("nav-over-hero");
      } else {
        nav.classList.add("nav-over-hero");
        nav.classList.remove("nav-scrolled");
      }
      if (bar) {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        var p = max > 0 ? Math.min(1, Math.max(0, y / max)) : 0;
        bar.style.transform = "scaleX(" + p.toFixed(4) + ")";
      }
    };
    var onScroll = function () {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });

    // Scroll-spy: mark the nav link for whichever section sits in a thin band
    // near the top of the viewport with aria-current="location" (and clear the
    // rest). Deferred to DOM-ready because this inline script runs while the nav
    // is parsed, before the sections below it exist in the document.
    var setupSpy = function () {
      var links = {};
      nav.querySelectorAll(".nav-link").forEach(function (a) {
        links[a.getAttribute("href")] = a;
      });
      var sections = Object.keys(links)
        .map(function (h) {
          return document.querySelector(h);
        })
        .filter(Boolean);
      if (!("IntersectionObserver" in window) || !sections.length) return;
      var spy = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var link = links["#" + e.target.id];
            if (!link) return;
            Object.keys(links).forEach(function (h) {
              links[h].removeAttribute("aria-current");
            });
            link.setAttribute("aria-current", "location");
          });
        },
        { rootMargin: "-45% 0px -50% 0px", threshold: 0 },
      );
      sections.forEach(function (s) {
        spy.observe(s);
      });
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupSpy);
    } else {
      setupSpy();
    }
  })();
</script>

<style>
  /* Scroll progress fill on the nav's lower edge. JS sets scaleX each frame so
     it tracks scroll 1:1 (no transition). Invisible at the top (scaleX 0). */
  .nav-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Scrolled into content: theme-colored nav + backdrop blur (both themes). */
  #site-nav.nav-scrolled {
    background-color: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: var(--blur-nav);
    -webkit-backdrop-filter: var(--blur-nav);
    border-bottom-color: var(--border);
  }
  #site-nav.nav-scrolled .container-page {
    padding-top: 0.625rem;
    padding-bottom: 0.625rem;
  }

  /* Over the hero: transparent bg + top-down scrim + forced white text,
     legible over any video frame in both themes. */
  #site-nav.nav-over-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    bottom: auto;
    height: 8rem;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
    z-index: -1;
  }
  #site-nav.nav-over-hero .nav-brand,
  #site-nav.nav-over-hero .nav-link,
  #site-nav.nav-over-hero .nav-resume,
  #site-nav.nav-over-hero .nav-toggle :global(button),
  #site-nav.nav-over-hero .nav-mobile :global(button) {
    color: #fff;
  }
  #site-nav.nav-over-hero .nav-resume {
    border-color: rgba(255, 255, 255, 0.4);
  }
  @media (hover: hover) and (pointer: fine) {
    #site-nav.nav-over-hero .nav-resume:hover,
    #site-nav.nav-over-hero .nav-toggle :global(button):hover,
    #site-nav.nav-over-hero .nav-mobile :global(button):hover {
      background-color: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, var(--on-media-soft));
    }
  }
</style>
