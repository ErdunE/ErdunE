---
import { getImage } from "astro:assets";
import { experience } from "@/data/experience";
import ExperienceTimeline from "./ExperienceTimeline.tsx";
import type { ExpItem } from "./ExperienceTimeline.tsx";
import { endKey, endLabel, formatRange, startKey } from "@/lib/dates";
import { langOf, t, UI } from "@/lib/i18n";

const lang = langOf(Astro.currentLocale);

/**
 * The axis has to read monotonically, so order is derived rather than taken
 * from the array: most recent end first, then most recent start. Current roles
 * tie at the front, which keeps PromptLint from being buried behind a course
 * project that merely started later. Entries with no dates sort last.
 * Adding a role means appending it anywhere; the order follows from the dates.
 */
const ordered = [...experience].sort(
  (a, b) => endKey(b) - endKey(a) || startKey(b) - startKey(a),
);

const items: ExpItem[] = await Promise.all(
  ordered.map(async (e) => {
    let logo: ExpItem["logo"] = null;
    if (e.logo) {
      const img = await getImage({
        src: e.logo,
        width: 96,
        densities: [1, 2],
        format: "webp",
      });
      logo = { src: img.src, srcSet: img.srcSet.attribute };
    }
    return {
      role: e.role,
      company: e.company,
      short: e.short ?? e.company,
      time: formatRange(e, lang),
      end: endLabel(e, lang),
      logoFit: e.logoFit ?? "cover",
      detail: e.detail,
      logo,
    };
  }),
);
---

<section id="experience" class="border-t border-border py-16 sm:py-20">
  <div class="container-page">
    <div data-reveal-stagger>
      <p class="eyebrow">
        <span class="text-accent">01 /</span>{" "}{t(UI.sections.experience.eyebrow, lang)}
      </p>
      <h2 class="h-section mt-2 text-text">{t(UI.sections.experience.heading, lang)}</h2>
      <p class="mt-3 max-w-3xl text-pretty text-muted">
        {t(UI.sections.experience.subtitle, lang)}
      </p>
    </div>

    <div class="mt-10" data-reveal>
      <ExperienceTimeline items={items} lang={lang} client:visible />
    </div>
  </div>
</section>
