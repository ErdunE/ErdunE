---
import { Mail } from "lucide-react";
import { profile } from "@/data/profile";
import { buttonVariants } from "@/components/ui/button";
import { brandIcons } from "@/lib/brand-icons";
import WeChatDialog from "./WeChatDialog.tsx";

const { contact, social, resumeHref, wechatQr } = profile;
const intro = contact.intro.split("\n");

const tile =
  "group focus-ring card-hover flex items-center gap-3 rounded-[var(--radius-card)] border border-border bg-surface p-3.5";
const iconWrap = "flex size-9 shrink-0 items-center justify-center";
---

<section id="contact" class="blueprint border-t border-border py-16 sm:py-20">
  <div class="container-page">
    <div data-reveal-stagger>
      <p class="eyebrow"><span class="text-accent">06 /</span> Contact</p>
      <h2 class="h-section mt-2 text-text">Get in touch</h2>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2" data-reveal-stagger>
      {/* About / status */}
      <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6">
        <p
          class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-accent/30 bg-accent-soft px-3 py-1 font-mono text-[11px] uppercase tracking-[0.12em] text-accent"
        >
          <span class="size-1.5 rounded-full bg-accent"></span>
          {contact.status}
        </p>

        <div class="mt-5 space-y-1 text-muted">
          {intro.map((line) => <p>{line}</p>)}
        </div>

        <p class="mt-4 text-sm text-faint">{contact.detail}</p>

        <a
          href={resumeHref}
          target="_blank"
          rel="noopener"
          class={buttonVariants({ size: "lg", className: "mt-6" })}
        >
          {contact.resumeLabel}
        </a>
      </div>

      {/* Social link grid */}
      <div class="rounded-[var(--radius-card)] border border-border bg-surface-2 p-6">
        <h3 class="eyebrow">Connect with me</h3>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {
            social.map((link) => {
              if (link.id === "wechat") {
                return <WeChatDialog qrSrc={wechatQr} client:visible />;
              }
              return (
                <a href={link.href} target="_blank" rel="noopener" class={tile}>
                  <span class={iconWrap}>
                    {link.id === "email" ? (
                      <Mail className="size-6 text-accent" />
                    ) : (
                      <svg
                        class="size-7"
                        viewBox={brandIcons[link.id].viewBox}
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true"
                        set:html={brandIcons[link.id].inner}
                      />
                    )}
                  </span>
                  <span class="min-w-0">
                    <span class="block text-sm font-medium text-text">{link.name}</span>
                    <span class="block text-xs text-muted">{link.detail}</span>
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>
