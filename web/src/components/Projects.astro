---
import { getImage } from "astro:assets";
import { projects } from "@/data/projects";
import ProjectsCarousel from "./ProjectsCarousel.tsx";
import type { ProjItem } from "./ProjectsCarousel.tsx";
import { langOf, t, tAll, UI } from "@/lib/i18n";

const lang = langOf(Astro.currentLocale);

const items: ProjItem[] = await Promise.all(
  projects.map(async (p) => {
    const img = await getImage({
      src: p.thumbnail,
      width: 640,
      densities: [1, 2],
      format: "webp",
    });
    return {
      title: t(p.title, lang),
      href: p.href,
      descPrimary: t(p.descPrimary, lang),
      descSecondary: t(p.descSecondary, lang),
      tags: tAll(p.tags, lang),
      thumb: { src: img.src, srcSet: img.srcSet.attribute },
    };
  }),
);
---

<section id="projects" class="overflow-hidden border-t border-border py-16 sm:py-20">
  <div class="container-page" data-reveal-stagger>
    <p class="eyebrow">
      <span class="text-accent">02 /</span>{" "}{t(UI.sections.projects.eyebrow, lang)}
    </p>
    <h2 class="h-section mt-2 text-text">{t(UI.sections.projects.heading, lang)}</h2>
    <p class="mt-3 max-w-3xl text-pretty text-muted">
      {t(UI.sections.projects.subtitle, lang)}
    </p>
  </div>

  {/* client:load (not client:visible) so the carousel always mounts on page
      load and the cards never depend on scroll/visibility to appear. */}
  <div class="mt-10">
    <ProjectsCarousel items={items} client:load />
  </div>
</section>
