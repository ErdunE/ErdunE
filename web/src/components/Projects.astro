---
import { getImage } from "astro:assets";
import { projects } from "@/data/projects";
import ProjectsCarousel from "./ProjectsCarousel.tsx";
import type { ProjItem } from "./ProjectsCarousel.tsx";

const items: ProjItem[] = await Promise.all(
  projects.map(async (p) => {
    const img = await getImage({
      src: p.thumbnail,
      width: 640,
      densities: [1, 2],
      format: "webp",
    });
    return {
      title: p.title,
      href: p.href,
      descPrimary: p.descPrimary,
      descSecondary: p.descSecondary,
      tags: p.tags,
      thumb: { src: img.src, srcSet: img.srcSet.attribute },
    };
  }),
);
---

<section id="projects" class="overflow-hidden border-t border-border py-16 sm:py-20">
  <div class="container-page" data-reveal-stagger>
    <p class="eyebrow">Projects</p>
    <h2 class="h-section mt-3 text-text">Things I've shipped</h2>
    <p class="mt-3 max-w-3xl text-pretty text-muted">
      Drag, scroll, or swipe to rotate through the work. Tap the centered card to open it.
    </p>
  </div>

  <div class="mt-10">
    <ProjectsCarousel items={items} client:visible />
  </div>
</section>
