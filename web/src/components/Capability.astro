---
import { Network, ShieldCheck, GitBranch, Compass } from "lucide-react";
import {
  capabilityLead,
  capabilities,
  capabilityContext,
} from "@/data/capabilities";

// Icons are presentational, so they live with the component (not the data).
const icons = [Network, ShieldCheck, GitBranch, Compass];
---

<section id="capability" class="border-t border-border py-16 sm:py-20">
  <div class="container-page">
    <div data-reveal-stagger>
      <p class="eyebrow">Capability</p>
      <h2 class="h-section mt-3 text-text">How I approach the work</h2>
    </div>

    <p class="mt-5 text-pretty text-lg leading-relaxed text-muted" data-reveal>
      {capabilityLead}
    </p>

    <div class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2" data-reveal-stagger>
      {
        capabilities.map((cap, i) => {
          const Icon = icons[i] ?? Network;
          return (
            <div class="cap-cell grid grid-cols-[auto_1fr] gap-4 sm:gap-5">
              <span class="cap-icon flex size-12 shrink-0 items-center justify-center rounded-[var(--radius-card)] bg-accent-soft text-accent">
                <Icon className="size-6" />
              </span>
              <div>
                <h3 class="font-display text-lg font-semibold text-text">
                  {cap.title}
                </h3>
                <p class="mt-2 text-pretty text-muted">{cap.body}</p>
                <p class="mt-2 text-pretty text-sm text-faint">{cap.bodyMuted}</p>
              </div>
            </div>
          );
        })
      }
    </div>

    <div
      class="mt-12 rounded-[var(--radius-card)] border border-border bg-surface-2 p-5"
      data-reveal
    >
      <p class="eyebrow">{capabilityContext.title}</p>
      <p class="mt-2 text-pretty text-sm leading-relaxed text-muted">
        {capabilityContext.text}
      </p>
    </div>
  </div>
</section>
