---
import { SIGNATURE_PATH, SIGNATURE_VIEWBOX } from "@/data/signature";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

{/* Filled-outline path: the single closed subpath traces the signature
    boundary, so it renders solid with fill (not a hairline stroke).
    Phase 4 draw-on → left-to-right clip/mask reveal. */}
<svg
  class={className}
  viewBox={SIGNATURE_VIEWBOX}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Erdun E signature"
>
  <path d={SIGNATURE_PATH} fill="currentColor" stroke="none" />
</svg>
