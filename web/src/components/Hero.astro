---
import HeroIntro from "./HeroIntro.tsx";
import Signal from "./Signal.astro";
---

<section
  id="hero"
  class="relative isolate min-h-[100svh] overflow-hidden"
>
  {/* Full-bleed background video: original full-quality mp4 (the 18 MB size is a
      deliberate quality choice; the poster shows first while it buffers). */}
  <video
    id="hero-video"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/video/poster.webp"
    aria-hidden="true"
  >
    <source src="/video/background.mp4" type="video/mp4" />
  </video>
  <script is:inline>
    (function () {
      var v = document.getElementById("hero-video");
      if (!v) return;
      var play = function () {
        var p = v.play();
        if (p && typeof p.catch === "function") p.catch(function () {});
      };
      if (v.readyState >= 3) play();
      else v.addEventListener("canplay", play, { once: true });
    })();
  </script>

  {/* Dark scrim: guarantees legibility in both themes */}
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-black/55 via-black/45 to-black/75"
  >
  </div>

  {/* Identity is centered and is the main act (HeroIntro Motion island). The
      Signal HUD floats over the video, pinned to the right on desktop (absolute,
      so it scrolls away with the hero); on mobile it drops into the flow below
      the identity as a near-solid panel. */}
  <div
    class="container-page flex min-h-[100svh] flex-col items-center justify-center gap-10 py-24 lg:gap-0"
  >
    <div class="w-full max-w-[640px]">
      <HeroIntro client:load />
    </div>
    <div class="signal-hud w-full max-w-[640px] lg:max-w-none">
      <Signal />
    </div>
  </div>

  {/* No-JS fallback: reveal the entrance's hidden initial state. */}
  <noscript>
    <style>
      #hero *,
      #hero *::before {
        opacity: 1 !important;
        clip-path: none !important;
        transform: none !important;
      }
    </style>
  </noscript>
</section>

<style>
  /* Desktop: lift the Signal panel out of flow into a right-pinned HUD. Absolute
     (not fixed) so it scrolls away with the hero. */
  @media (min-width: 1024px) {
    #hero .signal-hud {
      position: absolute;
      top: 50%;
      right: 32px;
      transform: translateY(-50%);
      width: 360px;
      max-width: none;
    }
  }
</style>
