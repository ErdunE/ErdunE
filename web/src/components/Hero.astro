---
import { profile } from "@/data/profile";
import Signature from "./Signature.astro";

const { name, role, heroStatus, tagline, subline, resumeHref } = profile;

const ctaBase =
  "inline-flex h-11 items-center justify-center rounded-[var(--radius-sm)] px-6 text-sm font-medium transition-[color,background-color,transform] duration-200 active:scale-[0.98] outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-transparent";
const ctaPrimary = `${ctaBase} bg-accent text-white hover:bg-accent/90 focus-visible:ring-accent`;
const ctaOutline = `${ctaBase} border border-white/30 text-white hover:bg-white/10 focus-visible:ring-white/60`;
const ctaGhost = `${ctaBase} text-white/85 hover:bg-white/10 hover:text-white focus-visible:ring-white/60`;
---

<section
  id="hero"
  class="relative isolate flex min-h-[100svh] items-center justify-center overflow-hidden"
>
  {/* Full-bleed background video (re-encode is Phase 7) */}
  <video
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/video/poster.jpg"
    aria-hidden="true"
  >
    <source src="/video/background.mp4" type="video/mp4" />
  </video>

  {/* Dark scrim — guarantees legibility in both themes */}
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-black/55 via-black/45 to-black/75"
  >
  </div>

  {/* Glass card (glassmorphism = hero only) */}
  <div class="container-page py-28">
    <div
      class="mx-auto max-w-2xl rounded-[var(--radius-card)] border border-white/15 bg-white/[0.06] px-6 py-10 text-center shadow-2xl backdrop-blur-xl sm:px-10 sm:py-12"
    >
      <span
        class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-accent/40 bg-accent/15 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.14em] text-white"
      >
        <span class="size-1.5 rounded-full bg-accent"></span>
        {heroStatus}
      </span>

      <h1 class="h-display mt-6 text-white">{name}</h1>

      <p
        class="mt-2 font-mono text-xs uppercase tracking-[0.16em] text-white/70 sm:text-sm"
      >
        {role}
      </p>

      <Signature class="mx-auto mt-7 h-auto w-[78%] max-w-sm text-accent" />

      <p class="mt-7 text-lg text-white/90">{tagline}</p>
      <p class="mt-2 text-sm text-white/65">{subline}</p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="#projects" class={ctaPrimary}>View work</a>
        <a href="#experience" class={ctaOutline}>Experience</a>
        <a href={resumeHref} target="_blank" rel="noopener" class={ctaGhost}>
          Résumé
        </a>
      </div>
    </div>
  </div>
</section>
