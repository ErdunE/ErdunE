---
import HeroIntro from "./HeroIntro.tsx";
---

<section
  id="hero"
  class="relative isolate flex min-h-[100svh] items-center justify-center overflow-hidden"
>
  {/* Full-bleed background video (re-encode is Phase 7) */}
  <video
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/video/poster.jpg"
    aria-hidden="true"
  >
    <source src="/video/background.mp4" type="video/mp4" />
  </video>

  {/* Dark scrim: guarantees legibility in both themes */}
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-black/55 via-black/45 to-black/75"
  >
  </div>

  {/* Glass card + orchestrated entrance (HeroIntro is a Motion island) */}
  <div class="container-page py-28">
    <HeroIntro client:load />
  </div>

  {/* No-JS fallback: reveal the entrance's hidden initial state. */}
  <noscript>
    <style>
      #hero *,
      #hero *::before {
        opacity: 1 !important;
        clip-path: none !important;
        transform: none !important;
      }
    </style>
  </noscript>
</section>
