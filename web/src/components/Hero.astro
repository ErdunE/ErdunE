---
import HeroIntro from "./HeroIntro.tsx";
---

<section
  id="hero"
  class="relative isolate flex min-h-[100svh] items-center justify-center overflow-hidden"
>
  {/* Full-bleed background video: original full-quality mp4 (the 18 MB size is a
      deliberate quality choice; the poster shows first while it buffers). */}
  <video
    id="hero-video"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/video/poster.webp"
    aria-hidden="true"
  >
    <source src="/video/background.mp4" type="video/mp4" />
  </video>
  <script is:inline>
    (function () {
      var v = document.getElementById("hero-video");
      if (!v) return;
      var play = function () {
        var p = v.play();
        if (p && typeof p.catch === "function") p.catch(function () {});
      };
      if (v.readyState >= 3) play();
      else v.addEventListener("canplay", play, { once: true });
    })();
  </script>

  {/* Dark scrim: guarantees legibility in both themes */}
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-black/55 via-black/45 to-black/75"
  >
  </div>

  {/* Glass card + orchestrated entrance (HeroIntro is a Motion island) */}
  <div class="container-page py-28">
    <HeroIntro client:load />
  </div>

  {/* No-JS fallback: reveal the entrance's hidden initial state. */}
  <noscript>
    <style>
      #hero *,
      #hero *::before {
        opacity: 1 !important;
        clip-path: none !important;
        transform: none !important;
      }
    </style>
  </noscript>
</section>
