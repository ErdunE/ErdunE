---
import { log, type LogSource } from "@/data/log";

const sorted = [...log].sort((a, b) => b.date.localeCompare(a.date));

const SOURCE_LABEL: Record<LogSource, string> = {
  project: "Project",
  event: "Event",
  press: "Press",
  milestone: "Milestone",
  note: "Note",
};

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
function fmtDate(iso: string): string {
  const [, m, d] = iso.split("-").map(Number);
  return `${MONTHS[m - 1]} ${d}`;
}
---

<section class="signal-panel" aria-label="Recent activity">
  <header class="signal-header">
    <span class="signal-pulse" aria-hidden="true"></span>
    <span class="signal-heading">Recent activity</span>
  </header>

  <div class="signal-scroll">
    <ul>
      {
        sorted.map((e, i) => (
          <li class="signal-item" style={`--i:${i}`}>
            <div class="signal-meta">
              <time datetime={e.date} class="signal-date">
                {fmtDate(e.date)}
              </time>
              <span class="signal-tag">{SOURCE_LABEL[e.source]}</span>
            </div>

            <div class="signal-body">
              {e.link ? (
                <a
                  href={e.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="signal-title focus-ring"
                >
                  {e.title}
                </a>
              ) : (
                <span class="signal-title">{e.title}</span>
              )}

              {e.media && (
                <img
                  class="signal-thumb"
                  src={e.media}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                  width="360"
                  height="90"
                />
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Pause the pulse when the panel scrolls off-screen (perf). reduced-motion has
  // no pulse animation, so there is nothing to pause in that case.
  const panel = document.querySelector(".signal-panel");
  if (panel && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries)
          panel.classList.toggle("signal-offscreen", !en.isIntersecting);
      },
      { threshold: 0 },
    );
    io.observe(panel);
  }
</script>

<style>
  /* Panel: near-solid on mobile (readable + cheap); airy glass on desktop. The
     glass is intentionally NOT theme-aware (light text on deep neutral glass
     reads over the video in both themes). */
  .signal-panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    background: rgba(24, 26, 32, 0.92);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.32);
  }
  @media (min-width: 1024px) {
    .signal-panel {
      background: var(--glass-bg);
      -webkit-backdrop-filter: var(--glass-blur);
      backdrop-filter: var(--glass-blur);
    }
  }

  /* Header */
  .signal-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .signal-heading {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.92);
  }
  .signal-pulse {
    position: relative;
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    background: #ff7a4d;
  }
  @media (prefers-reduced-motion: no-preference) {
    .signal-pulse::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: var(--radius-pill);
      background: #ff7a4d;
      animation: signal-pulse 2s var(--ease-brand) infinite;
    }
    .signal-offscreen .signal-pulse::after {
      animation-play-state: paused;
    }
  }
  @keyframes signal-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  /* Scroll area: bottom fade hint + thin light scrollbar. */
  .signal-scroll {
    max-height: clamp(280px, 58vh, 430px);
    overflow-y: auto;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 28px), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 28px), transparent);
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
  }
  .signal-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .signal-scroll::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-pill);
  }

  /* Items: meta column (date + tag) | body column (title + thumb). */
  .signal-item {
    display: grid;
    grid-template-columns: 58px 1fr;
    column-gap: 14px;
    align-items: start;
    padding: 14px 18px;
  }
  .signal-item + .signal-item {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .signal-meta {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .signal-date {
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.6);
  }
  .signal-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ff8a5c;
  }
  .signal-title {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--font-sans);
    font-size: 13.5px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.95);
    transition: color var(--dur-micro) ease;
  }
  a.signal-title:hover {
    color: #ff8a5c;
  }
  .signal-thumb {
    margin-top: 8px;
    width: 100%;
    height: 90px;
    object-fit: cover;
    border-radius: 8px;
  }

  /* Restrained on-load entrance: items fade-up, staggered <=60ms.
     Gated on no-preference so reduced-motion shows the final state. */
  @media (prefers-reduced-motion: no-preference) {
    .signal-item {
      animation: signal-in var(--dur-fast) var(--ease-brand) both;
      animation-delay: calc(var(--i) * 50ms);
    }
  }
  @keyframes signal-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
