---
import { getImage } from "astro:assets";
import { testimonials } from "@/data/testimonials";
import Testimonials from "./Testimonials.tsx";
import type { TItem } from "./Testimonials.tsx";

const items: TItem[] = await Promise.all(
  testimonials.map(async (t) => {
    const img = await getImage({
      src: t.avatar,
      width: 96,
      densities: [1, 2],
      format: "webp",
    });
    return {
      quote: t.quote,
      name: t.name,
      title: t.title,
      company: t.company,
      avatar: { src: img.src, srcSet: img.srcSet.attribute },
    };
  }),
);
---

<section id="testimonials" class="overflow-hidden border-t border-border py-16 sm:py-20">
  <div class="container-page">
    <p class="eyebrow">Testimonials</p>
    <h2 class="h-section mt-3 text-text">What collaborators say</h2>
    <p class="mt-3 max-w-3xl text-pretty text-muted">
      A few words from people Erdun has worked, built, and taught alongside.
    </p>
  </div>

  <div class="mt-10">
    <Testimonials items={items} client:visible />
  </div>
</section>
