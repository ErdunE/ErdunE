---
import { getImage } from "astro:assets";
import { testimonials } from "@/data/testimonials";
import Testimonials from "./Testimonials.tsx";
import type { TItem } from "./Testimonials.tsx";
import { langOf, t, UI } from "@/lib/i18n";

const lang = langOf(Astro.currentLocale);

const items: TItem[] = await Promise.all(
  testimonials.map(async (t) => {
    const img = await getImage({
      src: t.avatar,
      width: 96,
      densities: [1, 2],
      format: "webp",
    });
    return {
      quote: t.quote,
      name: t.name,
      title: t.title,
      company: t.company,
      linkedin: t.linkedin,
      avatar: { src: img.src, srcSet: img.srcSet.attribute },
    };
  }),
);
---

<section id="testimonials" class="overflow-hidden border-t border-border py-16 sm:py-20">
  <div class="container-page" data-reveal-stagger>
    <p class="eyebrow">
      <span class="text-accent">04 /</span>{" "}{t(UI.sections.testimonials.eyebrow, lang)}
    </p>
    <h2 class="h-section mt-2 text-text">{t(UI.sections.testimonials.heading, lang)}</h2>
    <p class="mt-3 max-w-3xl text-pretty text-muted">
      {t(UI.sections.testimonials.subtitle, lang)}
    </p>
  </div>

  <div class="mt-10" data-reveal>
    <Testimonials items={items} client:visible />
  </div>
</section>
