---
import { HOME_PATH, HREFLANG, LANG_NAME, langOf, otherLang, t, UI } from "@/lib/i18n";
import { buttonVariants } from "@/components/ui/button";

const lang = langOf(Astro.currentLocale);
const other = otherLang(lang);
---

{/*
  A plain link, not a React island: the two locales are two documents, so
  switching is a navigation and needs no JS. The label is always written in the
  language it switches *to*, so the reader who needs it can read it.

  Styled with the same `outline` button as Résumé beside it — the two are the
  same kind of control. Taller below `sm`, where Résumé is hidden and this is a
  touch target rather than a mouse one.
*/}
<a
  href={HOME_PATH[other]}
  hreflang={HREFLANG[other]}
  lang={HREFLANG[other]}
  data-lang-switch
  aria-label={t(UI.nav.switchLang, lang)}
  class={buttonVariants({
    variant: "outline",
    size: "sm",
    className: "nav-lang h-11 sm:h-9",
  })}
>
  {LANG_NAME[other]}
</a>

<script is:inline>
  // Carry the reader's place across the switch: /#projects -> /zh/#projects.
  // Progressive only — without JS the link still lands on the other home page.
  (function () {
    document.querySelectorAll("[data-lang-switch]").forEach(function (a) {
      a.addEventListener("click", function () {
        if (location.hash) a.setAttribute("href", a.pathname + location.hash);
      });
    });
  })();
</script>
